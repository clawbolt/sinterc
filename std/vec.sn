// std.vec：Vec<T> 的常用函数。比较元素用 std.math 的 Eq；map、filter 等接收闭包。
use std.math

pub fn sum(v: Vec<I64>) -> I64 {
    var s = 0
    for x in v {
        s = s + x
    }
    s
}

// 最大的元素；空的 Vec 是 .None。
pub fn max(v: Vec<I64>) -> Option<I64> {
    if vec_len(v) == 0 { return .None }
    var m = vec_get(v, 0)
    for x in v {
        if x > m { m = x }
    }
    .Some(m)
}

pub fn contains<T: math.Eq>(v: Vec<T>, x: T) -> Bool {
    for y in v {
        if y.eq(x) { return true }
    }
    false
}

// 第一个等于 x 的元素的下标；没有时是 .None。
pub fn index_of<T: math.Eq>(v: Vec<T>, x: T) -> Option<I64> {
    var i = 0
    for y in v {
        if y.eq(x) { return .Some(i) }
        i = i + 1
    }
    .None
}

// 原地反转：把元素依次 pop 进一个新的 Vec，再换回去。
pub fn reverse<T>(inout v: Vec<T>) {
    var out: Vec<T> = vec_new()
    var go = true
    while go {
        match vec_pop(v) {
            .Some(x) => vec_push(out, x),
            .None => { go = false }
        }
    }
    v = out
}

// 下面几个函数接收闭包（Lean `Closures.Param`）：闭包只能当实参传，可以读、改外面的变量，例如
//   vec.map(v, |x| x * k)、vec.for_each(v, |x| { total = total + x })。

// 对每个元素调用 f，结果按顺序放进新的 Vec。
pub fn map<T, U>(v: Vec<T>, f: fn(T) -> U) -> Vec<U> {
    var out: Vec<U> = vec_new()
    for x in v {
        out.push(f(x))
    }
    out
}

// 留下 f 为真的元素（按原来的顺序），其余的析构。元素是移动进来的，所以 v 按 sink 传入。
pub fn filter<T>(sink v: Vec<T>, f: fn(T) -> Bool) -> Vec<T> {
    var kept: Vec<T> = vec_new()
    var go = true
    while go {
        match vec_pop(v) {
            .Some(x) => {
                if f(x) { kept.push(x) }
            },
            .None => { go = false }
        }
    }
    reverse(kept)
    kept
}

pub fn any<T>(v: Vec<T>, f: fn(T) -> Bool) -> Bool {
    for x in v {
        if f(x) { return true }
    }
    false
}

pub fn all<T>(v: Vec<T>, f: fn(T) -> Bool) -> Bool {
    for x in v {
        if !f(x) { return false }
    }
    true
}

pub fn count<T>(v: Vec<T>, f: fn(T) -> Bool) -> I64 {
    var n = 0
    for x in v {
        if f(x) { n = n + 1 }
    }
    n
}

pub fn for_each<T>(v: Vec<T>, f: fn(T)) {
    for x in v {
        f(x)
    }
}

// 从 init 开始，依次把累积值和每个元素交给 f，得到新的累积值。
pub fn fold<T, A>(v: Vec<T>, sink init: A, f: fn(A, T) -> A) -> A {
    var acc = init
    for x in v {
        acc = f(acc, x)
    }
    acc
}

// 排序（Lean `Library.HeapSort`）：堆排序，只用 vec_swap 交换元素，O(n log n)。不稳定：相等的元素先后可能变。
// less(a, b) 为真表示 a 要排在 b 前面，要是严格弱序（例如 |a, b| a < b、|p, q| p.age < q.age）。

// v 的前 m 个元素里，从 i0 往下调整成堆：取较大的孩子，比自己大就交换、继续往下（`Library.HeapSort` 的 siftDown）。
fn sift<T>(inout v: Vec<T>, m: I64, i0: I64, less: fn(T, T) -> Bool) {
    var i = i0
    var go = true
    while go && 2 * i + 1 < m {
        var c = 2 * i + 1
        if c + 1 < m && less(vec_get(v, c), vec_get(v, c + 1)) { c = c + 1 }
        if less(vec_get(v, i), vec_get(v, c)) {
            vec_swap(v, i, c)
            i = c
        } else {
            go = false
        }
    }
}

pub fn sort_by<T>(inout v: Vec<T>, less: fn(T, T) -> Bool) {
    let n = vec_len(v)
    // 建堆（`Library.HeapSort` 的 heapify）
    var k = n / 2
    while k > 0 {
        k = k - 1
        sift(v, n, k, less)
    }
    // 依次把堆顶换到末尾（`Library.HeapSort` 的 extract）
    var m = n
    while m > 1 {
        m = m - 1
        vec_swap(v, 0, m)
        sift(v, m, 0, less)
    }
}

// 按 std.math 的 Ord 从小到大排序。
pub fn sort<T: math.Ord>(inout v: Vec<T>) {
    sort_by(v, |a, b| a.cmp(b) == -1)
}

// 常用函数。

// 0, 1, …, n - 1。
pub fn range(n: I64) -> Vec<I64> {
    var v: Vec<I64> = vec_new()
    for i in 0..n {
        v.push(i)
    }
    v
}

// 最小的元素；空的 Vec 是 .None。
pub fn min(v: Vec<I64>) -> Option<I64> {
    if vec_len(v) == 0 { return .None }
    var m = vec_get(v, 0)
    for x in v {
        if x < m { m = x }
    }
    .Some(m)
}

pub fn sum_f64(v: Vec<F64>) -> F64 {
    var s = 0.0
    for x in v {
        s = s + x
    }
    s
}

// 在从小到大排好的 v 里找 x：找到时是 .Some(下标)（有多个时是第一个），否则 .None。
// 和 std.map 的查找一样是二分（Lean `Library.MapSearch`）。
pub fn binary_search<T: math.Ord>(v: Vec<T>, x: T) -> Option<I64> {
    var lo = 0
    var hi = vec_len(v)
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if vec_get(v, mid).cmp(x) == -1 { lo = mid + 1 } else { hi = mid }
    }
    if lo < vec_len(v) {
        if vec_get(v, lo).cmp(x) == 0 { return .Some(lo) }
    }
    .None
}

// 原地去掉相邻的重复元素（先排序就能去掉所有重复）。保留的元素用 vec_swap 往前换，多出来的析构。
pub fn dedup<T: math.Eq>(inout v: Vec<T>) {
    let n = vec_len(v)
    if n < 2 { return }
    var w = 1
    for r in 1..n {
        if !vec_get(v, r).eq(vec_get(v, w - 1)) {
            vec_swap(v, w, r)
            w = w + 1
        }
    }
    while vec_len(v) > w {
        let x = vec_pop(v)
    }
}
