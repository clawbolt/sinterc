// std.map：按键从小到大的映射 Map<K, V>，存成 AVL 树，查找、插入、删除都是对数时间。
// 键要实现预导入的 Ord。规格见 lean/Core/Library/TreeMap.lean：树的中序遍历就是 `Library.Map` 的有序表，
// 插入、删除和 `Library.Map` 的 ins、del 一致，所以 `Library.Map` 的定律照样成立（键严格递增，插入后查得到，删除后查不到，别的键不受影响）。
// `Library.TreeMap`、`Library.TreeMapAvl`（Lean）：插入、删除和有序列表上的版本一致，并保持 AVL 平衡（树高是对数）。
// m.get(k) 是值的借用 Option<&V in m>（借用还在时 m 被锁住）；遍历用 m.for_each(|k, v| …)。

struct Node<K, V> { left: Box<Tree<K, V>>, key: K, val: V, h: I64, right: Box<Tree<K, V>> }
enum Tree<K, V> { Br(Node<K, V>), Leaf }

// 根放在一个只有一个元素的 Vec 里：inout 参数不能把值移走，用 pop / push 把根取出来、放回去
pub struct Map<K, V> { slot: Vec<Tree<K, V>>, n: I64 }

impl<K, V> Map<K, V> {
    // 空的 Map：Map.new()（模块外写 map.Map.new()，或者 use std.map { Map }）
    fn new() -> Map<K, V> {
        var s: Vec<Tree<K, V>> = Vec.new()
        s.push(.Leaf)
        Map { slot: s, n: 0 }
    }
}

fn ht<K, V>(t: Tree<K, V>) -> I64 {
    match t {
        .Br(n) => n.h,
        .Leaf => 0
    }
}

fn left_h<K, V>(t: Tree<K, V>) -> I64 {
    match t {
        .Br(n) => ht(*n.left),
        .Leaf => 0
    }
}

fn right_h<K, V>(t: Tree<K, V>) -> I64 {
    match t {
        .Br(n) => ht(*n.right),
        .Leaf => 0
    }
}

// 以下对应 `Library.TreeMap` 的 mk、rotR、rotL、bal
fn mk<K, V>(sink l: Tree<K, V>, sink k: K, sink v: V, sink r: Tree<K, V>) -> Tree<K, V> {
    let h = ht(l).max(ht(r)) + 1
    .Br(Node { left: box(l), key: k, val: v, h: h, right: box(r) })
}

fn rot_r<K, V>(sink t: Tree<K, V>) -> Tree<K, V> {
    match t {
        .Br(n) => {
            let Node { left, key, val, h, right } = n
            let l = unbox(left)
            match l {
                .Br(ln) => {
                    let Node { left: a, key: lk, val: lv, h: lh, right: b } = ln
                    mk(unbox(a), lk, lv, mk(unbox(b), key, val, unbox(right)))
                },
                .Leaf => mk(.Leaf, key, val, unbox(right))
            }
        },
        .Leaf => .Leaf
    }
}

fn rot_l<K, V>(sink t: Tree<K, V>) -> Tree<K, V> {
    match t {
        .Br(n) => {
            let Node { left, key, val, h, right } = n
            let r = unbox(right)
            match r {
                .Br(rn) => {
                    let Node { left: a, key: rk, val: rv, h: rh, right: b } = rn
                    mk(mk(unbox(left), key, val, unbox(a)), rk, rv, unbox(b))
                },
                .Leaf => mk(unbox(left), key, val, .Leaf)
            }
        },
        .Leaf => .Leaf
    }
}

fn bal<K, V>(sink l: Tree<K, V>, sink k: K, sink v: V, sink r: Tree<K, V>) -> Tree<K, V> {
    let hl = ht(l)
    let hr = ht(r)
    if hl > hr + 1 {
        if left_h(l) >= right_h(l) { rot_r(mk(l, k, v, r)) } else { rot_r(mk(rot_l(l), k, v, r)) }
    } else if hr > hl + 1 {
        if right_h(r) >= left_h(r) { rot_l(mk(l, k, v, r)) } else { rot_l(mk(l, k, v, rot_r(r))) }
    } else {
        mk(l, k, v, r)
    }
}

// `Library.TreeMap` 的 insT；已有键 k 时换掉值，旧值放进 old
fn ins<K: Ord, V>(sink t: Tree<K, V>, sink k: K, sink v: V, inout old: Option<V>) -> Tree<K, V> {
    match t {
        .Br(n) => {
            let Node { left, key, val, h, right } = n
            let c = k.cmp(key).to_i64()
            if c == -1 {
                bal(ins(unbox(left), k, v, old), key, val, unbox(right))
            } else if c == 0 {
                old = .Some(val)
                .Br(Node { left: left, key: key, val: v, h: h, right: right })
            } else {
                bal(unbox(left), key, val, ins(unbox(right), k, v, old))
            }
        },
        .Leaf => mk(.Leaf, k, v, .Leaf)
    }
}

struct Popped<K, V> { key: K, val: V, rest: Tree<K, V> }

// `Library.TreeMap` 的 popK、popT：从以 (l, k, v, r) 组成的树里去掉最小的键
fn pop_min<K, V>(sink l: Tree<K, V>, sink k: K, sink v: V, sink r: Tree<K, V>) -> Popped<K, V> {
    match l {
        .Br(n) => {
            let Node { left, key, val, h, right } = n
            let p = pop_min(unbox(left), key, val, unbox(right))
            let Popped { key: k2, val: v2, rest } = p
            Popped { key: k2, val: v2, rest: bal(rest, k, v, r) }
        },
        .Leaf => Popped { key: k, val: v, rest: r }
    }
}

// `Library.TreeMap` 的 join：l 的键都小于 r 的键
fn concat<K, V>(sink l: Tree<K, V>, sink r: Tree<K, V>) -> Tree<K, V> {
    match r {
        .Br(n) => {
            let Node { left, key, val, h, right } = n
            let p = pop_min(unbox(left), key, val, unbox(right))
            let Popped { key: k2, val: v2, rest } = p
            bal(l, k2, v2, rest)
        },
        .Leaf => l
    }
}

// `Library.TreeMap` 的 delT；去掉的值放进 old
fn del<K: Ord, V>(sink t: Tree<K, V>, k: K, inout old: Option<V>) -> Tree<K, V> {
    match t {
        .Br(n) => {
            let Node { left, key, val, h, right } = n
            let c = k.cmp(key).to_i64()
            if c == -1 {
                bal(del(unbox(left), k, old), key, val, unbox(right))
            } else if c == 0 {
                old = .Some(val)
                concat(unbox(left), unbox(right))
            } else {
                bal(unbox(left), key, val, del(unbox(right), k, old))
            }
        },
        .Leaf => .Leaf
    }
}

fn has<K: Ord, V>(t: Tree<K, V>, k: K) -> Bool {
    match t {
        .Br(n) => {
            let c = k.cmp(n.key).to_i64()
            if c == -1 { has(*n.left, k) } else if c == 0 { true } else { has(*n.right, k) }
        },
        .Leaf => false
    }
}

// k 的值的借用（返回借用，借自 t）
fn find<K: Ord, V>(t: Tree<K, V>, k: K) -> Option<&V in t> {
    match t {
        .Br(n) => {
            let c = k.cmp(n.key).to_i64()
            if c == -1 { find(*n.left, k) } else if c == 0 { .Some(&n.val) } else { find(*n.right, k) }
        },
        .Leaf => .None
    }
}

fn walk<K, V>(t: Tree<K, V>, f: fn(K, V)) {
    match t {
        .Br(n) => {
            walk(*n.left, f)
            f(n.key, n.val)
            walk(*n.right, f)
        },
        .Leaf => {}
    }
}

impl<K, V> Map<K, V> {
    fn len(m: Map<K, V>) -> I64 { m.n }

    fn is_empty(m: Map<K, V>) -> Bool { m.n == 0 }

    // 树高（空树是 0）。
    fn height(m: Map<K, V>) -> I64 {
        var r = 0
        for t in m.slot {
            r = ht(t)
        }
        r
    }

    // 按键从小到大，对每一对 (k, v) 调用 f。
    fn for_each(m: Map<K, V>, f: fn(K, V)) {
        for t in m.slot {
            walk(t, f)
        }
    }
}

impl<K: Ord, V> Map<K, V> {
    // 放进 (k, v)。已有键 k 时换掉它的值并返回旧值（这时 k 被析构，保留原来的键）；否则返回 .None。
    fn insert(inout m: Map<K, V>, sink k: K, sink v: V) -> Option<V> {
        var old: Option<V> = .None
        match m.slot.pop() {
            .Some(t) => m.slot.push(ins(t, k, v, old)),
            .None => {}
        }
        match let old {
            .Some(x) => {},
            .None => { m.n = m.n + 1 }
        }
        old
    }

    // 去掉键 k，返回它的值；没有这个键时返回 .None。
    fn remove(inout m: Map<K, V>, k: K) -> Option<V> {
        var old: Option<V> = .None
        match m.slot.pop() {
            .Some(t) => m.slot.push(del(t, k, old)),
            .None => {}
        }
        match let old {
            .Some(x) => { m.n = m.n - 1 },
            .None => {}
        }
        old
    }

    fn contains(m: Map<K, V>, k: K) -> Bool {
        for t in m.slot {
            return has(t, k)
        }
        false
    }

    // 键 k 的值的借用 &V in m；没有时是 .None。借用还在时 m 被锁住（不能插入、删除）。
    fn get(m: Map<K, V>, k: K) -> Option<&V in m> {
        for t in m.slot {
            return find(t, k)
        }
        .None
    }
}
