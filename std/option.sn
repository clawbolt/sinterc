// std.option：Option<T> 的常用函数。

pub fn is_some<T>(o: Option<T>) -> Bool {
    match let o {
        .Some(x) => true,
        .None => false
    }
}

pub fn is_none<T>(o: Option<T>) -> Bool {
    match let o {
        .Some(x) => false,
        .None => true
    }
}

// 有值时取出值（d 被析构），没有时用 d。
pub fn unwrap_or<T>(sink o: Option<T>, sink d: T) -> T {
    match o {
        .Some(x) => x,
        .None => d
    }
}

// 有值时取出值；.None 时 panic（程序结束）。
pub fn unwrap<T>(sink o: Option<T>) -> T {
    match o {
        .Some(x) => x,
        .None => panic("unwrap 了一个 .None")
    }
}

// 和 unwrap 一样，.None 时 panic 的说明是 msg。
pub fn expect<T>(sink o: Option<T>, msg: Str) -> T {
    match o {
        .Some(x) => x,
        .None => panic(msg)
    }
}
