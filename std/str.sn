// std.str：字符串的常用函数。按字节处理（没有 Unicode 的字符边界）；返回的新字符串都是新分配的。

use std.char

pub fn starts_with(s: Str, p: Str) -> Bool {
    if str_len(p) > str_len(s) { return false }
    str_eq(str_slice(s, 0, str_len(p)), p)
}

pub fn ends_with(s: Str, p: Str) -> Bool {
    let n = str_len(s)
    let m = str_len(p)
    if m > n { return false }
    str_eq(str_slice(s, n - m, n), p)
}

// p 第一次出现的位置；没有时是 .None。空的 p 出现在 0。
pub fn find(s: Str, p: Str) -> Option<I64> {
    let n = str_len(s)
    let m = str_len(p)
    var i = 0
    while i + m <= n {
        if str_eq(str_slice(s, i, i + m), p) { return .Some(i) }
        i = i + 1
    }
    .None
}

pub fn contains(s: Str, p: Str) -> Bool {
    match find(s, p) {
        .Some(i) => true,
        .None => false
    }
}

fn is_space(b: I64) -> Bool { b == 32 || b == 9 || b == 10 || b == 13 }

// 去掉开头和结尾的空格、制表符和换行。
pub fn trim(s: Str) -> Str {
    var a = 0
    var b = str_len(s)
    while a < b && is_space(str_byte(s, a)) { a = a + 1 }
    while b > a && is_space(str_byte(s, b - 1)) { b = b - 1 }
    str_slice(s, a, b)
}

// 按 sep 切开；sep 是空串时不切。"a,,b" 按 "," 切成 "a"、""、"b"。
pub fn split(s: Str, sep: Str) -> Vec<Str> {
    var out: Vec<Str> = vec_new()
    let n = str_len(s)
    let m = str_len(sep)
    var start = 0
    var i = 0
    while m > 0 && i + m <= n {
        if str_eq(str_slice(s, i, i + m), sep) {
            vec_push(out, str_slice(s, start, i))
            i = i + m
            start = i
        } else {
            i = i + 1
        }
    }
    vec_push(out, str_slice(s, start, n))
    out
}

// 用 sep 把各部分接起来。
pub fn join(parts: Vec<Str>, sep: Str) -> Str {
    var out: Str = ""
    var first = true
    for p in parts {
        if !first { str_push(out, sep) }
        str_push(out, p)
        first = false
    }
    out
}

// s 重复 n 次（n <= 0 时是空串）。
pub fn repeat(s: Str, n: I64) -> Str {
    var out: Str = ""
    var i = 0
    while i < n {
        str_push(out, s)
        i = i + 1
    }
    out
}

// 大小写转换（C52）：只转换 ASCII 字母，别的字符原样保留。
pub fn to_upper(s: Str) -> Str {
    var r = ""
    for c in s.chars() {
        r.push_char(char.to_upper(c))
    }
    r
}

pub fn to_lower(s: Str) -> Str {
    var r = ""
    for c in s.chars() {
        r.push_char(char.to_lower(c))
    }
    r
}

// 从左到右把不重叠的 from 换成 to；from 是空串时原样返回。
pub fn replace(s: Str, from: Str, to: Str) -> Str {
    let n = str_len(s)
    let m = str_len(from)
    if m == 0 { return str_clone(s) }
    var out = ""
    var start = 0
    var i = 0
    while i + m <= n {
        if str_eq(str_slice(s, i, i + m), from) {
            str_push(out, str_slice(s, start, i))
            str_push(out, to)
            i = i + m
            start = i
        } else {
            i = i + 1
        }
    }
    str_push(out, str_slice(s, start, n))
    out
}

// [a, b) 去掉末尾的 \r。
fn line_at(s: Str, a: I64, b: I64) -> Str {
    if b > a && str_byte(s, b - 1) == 13 { str_slice(s, a, b - 1) } else { str_slice(s, a, b) }
}

// 按换行切开，每行去掉末尾的 \r（Windows 换行）；最后的换行后面不再算一行。
pub fn lines(s: Str) -> Vec<Str> {
    var out: Vec<Str> = vec_new()
    let n = str_len(s)
    var start = 0
    var i = 0
    while i < n {
        if str_byte(s, i) == 10 {
            out.push(line_at(s, start, i))
            start = i + 1
        }
        i = i + 1
    }
    if start < n { out.push(line_at(s, start, n)) }
    out
}
