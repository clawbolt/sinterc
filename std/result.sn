// std.result：Result<T, E> 的常用函数。T、E 可以是 ()（C37），例如 result.is_ok(write_file(…))。

pub fn is_ok<T, E>(r: Result<T, E>) -> Bool {
    match let r {
        Ok(x) => true,
        Err(e) => false
    }
}

pub fn is_err<T, E>(r: Result<T, E>) -> Bool {
    match let r {
        Ok(x) => false,
        Err(e) => true
    }
}

// 成功时取出值（d 被析构），出错时用 d（错误值被析构）。
pub fn unwrap_or<T, E>(sink r: Result<T, E>, sink d: T) -> T {
    match r {
        Ok(x) => x,
        Err(e) => d
    }
}

// 成功时是 .Some(值)，出错时是 .None（错误值被析构）。
pub fn ok<T, E>(sink r: Result<T, E>) -> Option<T> {
    match r {
        Ok(x) => .Some(x),
        Err(e) => .None
    }
}

// 成功时取出值；出错时 panic（程序结束，见 C38）。错误值的类型是任意的 E，没法打印，要看错误用 expect 或 match。
pub fn unwrap<T, E>(sink r: Result<T, E>) -> T {
    match r {
        Ok(x) => x,
        Err(e) => panic("unwrap 了一个 Err")
    }
}

// 和 unwrap 一样，出错时 panic 的说明是 msg。
pub fn expect<T, E>(sink r: Result<T, E>, msg: Str) -> T {
    match r {
        Ok(x) => x,
        Err(e) => panic(msg)
    }
}
