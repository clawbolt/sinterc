// 预导入：Vec<T> 的类型函数和方法。intrinsic fn 是编译器实现的（= 后面是内建函数）；它们的元素类型不固定，类型由编译器单独检查，这里的签名是说明。
// 第一个参数不是 Vec<T> 的是类型函数，写成 Vec.new()：元素类型由 let 标注、返回值、实参或字段决定。
// v[i] 是位置（可以读、借用、赋值），v.get(i) 同 v[i]。接收闭包的方法（Lean `Closures.Param`）：闭包只能当实参传，可以读、改外面的变量，例如
//   v.map(|x| x * k)、v.for_each(|x| { total = total + x })。

impl<T> Vec<T> {
    intrinsic fn new() -> Vec<T> = vec_new
    intrinsic fn len(v: Vec<T>) -> I64 = vec_len

    // 放到末尾（容量不够时翻倍）。
    intrinsic fn push(inout v: Vec<T>, sink x: T) = vec_push

    // 拿走最后一个；空的时候是 .None。
    intrinsic fn pop(inout v: Vec<T>) -> Option<T> = vec_pop

    // 交换第 i、j 个元素；越界时 panic（Lean `Datatypes.VecSwap`）。
    intrinsic fn swap(inout v: Vec<T>, sink i: I64, sink j: I64) = vec_swap

    // 第 i 个元素这个位置，同 v[i]；越界时 panic。
    intrinsic fn get(v: Vec<T>, sink i: I64) -> T = vec_get

    fn is_empty(v: Vec<T>) -> Bool { vec_len(v) == 0 }

    // 原地反转：把元素依次 pop 进一个新的 Vec，再换回去。
    fn reverse(inout v: Vec<T>) {
        var out: Vec<T> = Vec.new()
        var go = true
        while go {
            match vec_pop(v) {
                .Some(x) => vec_push(out, x),
                .None => { go = false }
            }
        }
        v = out
    }

    // 对每个元素调用 f，结果按顺序放进新的 Vec。
    fn map<U>(v: Vec<T>, f: fn(T) -> U) -> Vec<U> {
        var out: Vec<U> = Vec.new()
        for x in v {
            out.push(f(x))
        }
        out
    }

    // 留下 f 为真的元素（按原来的顺序），其余的析构。元素是移动进来的，所以 v 按 sink 传入。
    fn filter(sink v: Vec<T>, f: fn(T) -> Bool) -> Vec<T> {
        var kept: Vec<T> = Vec.new()
        var go = true
        while go {
            match vec_pop(v) {
                .Some(x) => {
                    if f(x) { kept.push(x) }
                },
                .None => { go = false }
            }
        }
        kept.reverse()
        kept
    }

    fn any(v: Vec<T>, f: fn(T) -> Bool) -> Bool {
        for x in v {
            if f(x) { return true }
        }
        false
    }

    fn all(v: Vec<T>, f: fn(T) -> Bool) -> Bool {
        for x in v {
            if !f(x) { return false }
        }
        true
    }

    fn count(v: Vec<T>, f: fn(T) -> Bool) -> I64 {
        var n = 0
        for x in v {
            if f(x) { n = n + 1 }
        }
        n
    }

    fn for_each(v: Vec<T>, f: fn(T)) {
        for x in v {
            f(x)
        }
    }

    // 从 init 开始，依次把累积值和每个元素交给 f，得到新的累积值。
    fn fold<A>(v: Vec<T>, sink init: A, f: fn(A, T) -> A) -> A {
        var acc = init
        for x in v {
            acc = f(acc, x)
        }
        acc
    }

    // 排序（Lean `Library.HeapSort`）：堆排序，只用 vec_swap 交换元素，O(n log n)。不稳定：相等的元素先后可能变。
    // less(a, b) 为真表示 a 要排在 b 前面，要是严格弱序（例如 |a, b| a < b、|p, q| p.age < q.age）。
    fn sort_by(inout v: Vec<T>, less: fn(T, T) -> Bool) {
        let n = vec_len(v)
        // 建堆（`Library.HeapSort` 的 heapify）
        var k = n / 2
        while k > 0 {
            k = k - 1
            vec_sift(v, n, k, less)
        }
        // 依次把堆顶换到末尾（`Library.HeapSort` 的 extract）
        var m = n
        while m > 1 {
            m = m - 1
            vec_swap(v, 0, m)
            vec_sift(v, m, 0, less)
        }
    }
}

impl<T: Eq> Vec<T> {
    fn contains(v: Vec<T>, x: T) -> Bool {
        for y in v {
            if y.eq(x) { return true }
        }
        false
    }

    // 第一个等于 x 的元素的下标；没有时是 .None。
    fn index_of(v: Vec<T>, x: T) -> Option<I64> {
        var i = 0
        for y in v {
            if y.eq(x) { return .Some(i) }
            i = i + 1
        }
        .None
    }

    // 原地去掉相邻的重复元素（先排序就能去掉所有重复）。保留的元素用 vec_swap 往前换，多出来的析构。
    fn dedup(inout v: Vec<T>) {
        let n = vec_len(v)
        if n < 2 { return }
        var w = 1
        for r in 1..n {
            if !vec_get(v, r).eq(vec_get(v, w - 1)) {
                vec_swap(v, w, r)
                w = w + 1
            }
        }
        while vec_len(v) > w {
            let x = vec_pop(v)
        }
    }
}

impl<T: Ord> Vec<T> {
    // 按 Ord 从小到大排序。
    fn sort(inout v: Vec<T>) {
        v.sort_by(|a, b| a.cmp(b).is_lt())
    }

    // 在从小到大排好的 v 里找 x：找到时是 .Some(下标)（有多个时是第一个），否则 .None。
    // 二分查找（Lean `Library.MapSearch`）。
    fn binary_search(v: Vec<T>, x: T) -> Option<I64> {
        var lo = 0
        var hi = vec_len(v)
        while lo < hi {
            let mid = lo + (hi - lo) / 2
            if vec_get(v, mid).cmp(x).is_lt() { lo = mid + 1 } else { hi = mid }
        }
        if lo < vec_len(v) {
            if vec_get(v, lo).cmp(x).is_eq() { return .Some(lo) }
        }
        .None
    }
}

impl Vec<I64> {
    fn sum(v: Vec<I64>) -> I64 {
        var s = 0
        for x in v {
            s = s + x
        }
        s
    }

    // 最大的元素；空的 Vec 是 .None。
    fn max(v: Vec<I64>) -> Option<I64> {
        if vec_len(v) == 0 { return .None }
        var m = vec_get(v, 0)
        for x in v {
            if x > m { m = x }
        }
        .Some(m)
    }

    // 最小的元素；空的 Vec 是 .None。
    fn min(v: Vec<I64>) -> Option<I64> {
        if vec_len(v) == 0 { return .None }
        var m = vec_get(v, 0)
        for x in v {
            if x < m { m = x }
        }
        .Some(m)
    }
}

impl Vec<F64> {
    fn sum(v: Vec<F64>) -> F64 {
        var s = 0.0
        for x in v {
            s = s + x
        }
        s
    }

    // 最大的元素（按 <，NaN 不会被选中，除非它是第一个）；空的 Vec 是 .None。
    fn max(v: Vec<F64>) -> Option<F64> {
        if vec_len(v) == 0 { return .None }
        var m = vec_get(v, 0)
        for x in v {
            if x > m { m = x }
        }
        .Some(m)
    }

    fn min(v: Vec<F64>) -> Option<F64> {
        if vec_len(v) == 0 { return .None }
        var m = vec_get(v, 0)
        for x in v {
            if x < m { m = x }
        }
        .Some(m)
    }
}

// v 的前 m 个元素里，从 i0 往下调整成堆：取较大的孩子，比自己大就交换、继续往下（`Library.HeapSort` 的 siftDown）。
fn vec_sift<T>(inout v: Vec<T>, m: I64, i0: I64, less: fn(T, T) -> Bool) {
    var i = i0
    var go = true
    while go && 2 * i + 1 < m {
        var c = 2 * i + 1
        if c + 1 < m && less(vec_get(v, c), vec_get(v, c + 1)) { c = c + 1 }
        if less(vec_get(v, i), vec_get(v, c)) {
            vec_swap(v, i, c)
            i = c
        } else {
            go = false
        }
    }
}
