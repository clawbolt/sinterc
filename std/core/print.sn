// 预导入：打印。print、println 写到标准输出，eprint、eprintln 写到标准错误（写之前先刷新标准输出）；
// 带 ln 的在末尾加一个换行。核心部分里只有这个文件读写外部；打印用得太多，所以和 std.io 分开、预导入。

pub fn print(s: Str) { intrinsic.print_str(s) }

pub fn println(s: Str) { intrinsic.print(s) }

pub fn eprint(s: Str) { intrinsic.eprint_str(s) }

pub fn eprintln(s: Str) { intrinsic.eprint(s) }
