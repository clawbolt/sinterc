// 预导入：Result<T, E> 的方法。T、E 可以是 ()，例如 write_file(…).is_ok()。

impl<T, E> Result<T, E> {
    fn is_ok(r: Result<T, E>) -> Bool {
        match let r {
            Ok(x) => true,
            Err(e) => false
        }
    }

    fn is_err(r: Result<T, E>) -> Bool { !r.is_ok() }

    // 成功时取出值（d 被析构），出错时用 d（错误值被析构）。
    fn unwrap_or(sink r: Result<T, E>, sink d: T) -> T {
        match r {
            Ok(x) => x,
            Err(e) => d
        }
    }

    // 成功时是 .Some(值)，出错时是 .None（错误值被析构）。
    fn ok(sink r: Result<T, E>) -> Option<T> {
        match r {
            Ok(x) => .Some(x),
            Err(e) => .None
        }
    }

    // 成功时取出值；出错时 panic（程序结束）。错误值的类型是任意的 E，没法打印，要看错误用 expect 或 match。
    fn unwrap(sink r: Result<T, E>) -> T {
        match r {
            Ok(x) => x,
            Err(e) => panic("unwrap 了一个 Err")
        }
    }

    // 和 unwrap 一样，出错时 panic 的说明是 msg。
    fn expect(sink r: Result<T, E>, msg: Str) -> T {
        match r {
            Ok(x) => x,
            Err(e) => panic(msg)
        }
    }
}
