// 预导入：Char 的分类和大小写转换。只认 ASCII：'中'、'é' 既不是字母也不是数字，大小写转换原样返回。

impl Char {
    // Unicode 码点。
    intrinsic fn code(sink c: Char) -> I64 = char_code

    // UTF-8 编码的一个字符。
    intrinsic fn to_str(sink c: Char) -> Str = str_from_char

    fn is_digit(c: Char) -> Bool { c >= '0' && c <= '9' }

    fn is_upper(c: Char) -> Bool { c >= 'A' && c <= 'Z' }

    fn is_lower(c: Char) -> Bool { c >= 'a' && c <= 'z' }

    fn is_alpha(c: Char) -> Bool { c.is_upper() || c.is_lower() }

    fn is_alnum(c: Char) -> Bool { c.is_alpha() || c.is_digit() }

    // 空格、制表符、换行、回车。
    fn is_whitespace(c: Char) -> Bool { c == ' ' || c == '\t' || c == '\n' || char_code(c) == 13 }

    fn to_upper(c: Char) -> Char {
        if c.is_lower() { shift_char(c, -32) } else { c }
    }

    fn to_lower(c: Char) -> Char {
        if c.is_upper() { shift_char(c, 32) } else { c }
    }

    // '0'..'9' 对应的数；别的字符是 .None。
    fn to_digit(c: Char) -> Option<I64> {
        if c.is_digit() { .Some(char_code(c) - 48) } else { .None }
    }
}

// 码点加减 32 之后一定还是合法字符，.None 走不到。
fn shift_char(c: Char, d: I64) -> Char {
    match char_from(char_code(c) + d) {
        .Some(u) => u,
        .None => c
    }
}
