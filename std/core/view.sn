// 预导入：字符串切片 &str in a 的方法。切片不拥有内存，这里的方法都不分配新的字符串，
// 结果是同一块缓冲区里的切片（Lean `Strings.Slice`：子切片仍在缓冲区里）。缓冲区用 text(a, s) 放进区域 a。
// len、byte、sub、to_str、eq、eq_view、print_str 还是编译器的内建方法；find、find_from 和 Str 的一样返回 Option。
//
//     arena |a| {
//         let line = text(a, "x, 42 ,y")
//         let parts = line.split(",")
//         println(parts[1].trim().to_str())   // 42
//     }

impl &str in r {
    fn is_empty(v: &str in r) -> Bool { v.len() == 0 }

    // p 第一次出现的位置；没有时是 .None。
    fn find(v: &str in r, p: Str) -> Option<I64> { v.find_from(p, 0) }

    // p 从 i 开始第一次出现的位置；没有时是 .None。
    fn find_from(v: &str in r, p: Str, i: I64) -> Option<I64> {
        let from = if i < 0 { 0 } else { i }
        let k = view_find(v, p, from)
        if k < 0 { .None } else { .Some(k) }
    }

    fn contains(v: &str in r, p: Str) -> Bool { view_find(v, p, 0) >= 0 }

    fn starts_with(v: &str in r, p: Str) -> Bool {
        if str_len(p) > v.len() { return false }
        v.sub(0, str_len(p)).eq(p)
    }

    fn ends_with(v: &str in r, p: Str) -> Bool {
        let n = v.len()
        let m = str_len(p)
        if m > n { return false }
        v.sub(n - m, n).eq(p)
    }

    // 去掉两头的空格、制表符和换行。
    fn trim(v: &str in r) -> &str in r {
        var a = 0
        var b = v.len()
        while a < b && view_space(v.byte(a)) { a = a + 1 }
        while b > a && view_space(v.byte(b - 1)) { b = b - 1 }
        v.sub(a, b)
    }

    // 去掉行尾的一个 \r（\r\n 换行的文件）。
    fn trim_cr(v: &str in r) -> &str in r {
        let n = v.len()
        if n > 0 && v.byte(n - 1) == 13 { v.sub(0, n - 1) } else { v }
    }

    // 按 sep 切开（sep 不能为空）：n 个 sep 得到 n + 1 段，段可以是空的。
    fn split(v: &str in r, sep: Str) -> Vec<&str in r> {
        if str_len(sep) == 0 { panic("split 的分隔符不能为空") }
        var out: Vec<&str in r> = vec_new()
        var start = 0
        var i = view_find(v, sep, 0)
        while i >= 0 {
            out.push(v.sub(start, i))
            start = i + str_len(sep)
            i = view_find(v, sep, start)
        }
        out.push(v.sub(start, v.len()))
        out
    }

    // 按行切开：去掉行尾的 \n 和 \r\n；最后一行后面有没有换行都一样，空的切片没有行。
    fn lines(v: &str in r) -> Vec<&str in r> {
        var out: Vec<&str in r> = vec_new()
        let n = v.len()
        var start = 0
        while start < n {
            var e = view_find(v, "\n", start)
            if e < 0 { e = n }
            var stop = e
            if stop > start && v.byte(stop - 1) == 13 { stop = stop - 1 }
            out.push(v.sub(start, stop))
            start = e + 1
        }
        out
    }

    // 不收集成 Vec 的逐行访问：从 pos 开始的这一行在哪里结束（\n 的位置，没有时是 len）。
    //     var pos = 0
    //     while pos < data.len() {
    //         let e = data.line_end(pos)
    //         let line = data.sub(pos, e).trim_cr()
    //         …
    //         pos = e + 1
    //     }
    fn line_end(v: &str in r, pos: I64) -> I64 {
        let e = view_find(v, "\n", pos)
        if e < 0 { v.len() } else { e }
    }

    // 按 sep 切开后的第 i 段（从 0 开始，sep 不能为空），没有这么多段时是 .None；和 v.split(sep)[i] 相同，但不建 Vec。
    fn field(v: &str in r, sep: Str, i: I64) -> Option<&str in r> {
        if str_len(sep) == 0 { panic("split 的分隔符不能为空") }
        if i < 0 { return .None }
        var start = 0
        var k = 0
        while k < i {
            let j = view_find(v, sep, start)
            if j < 0 { return .None }
            start = j + str_len(sep)
            k = k + 1
        }
        let e = view_find(v, sep, start)
        if e < 0 { .Some(v.sub(start, v.len())) } else { .Some(v.sub(start, e)) }
    }

    // 十进制整数（可以有一个负号）；格式不对或超出 I64 范围时是 .None，和 Str 的 parse_i64 一样。
    // 按负数累加，这样 I64 的最小值也能表示。
    fn parse_i64(v: &str in r) -> Option<I64> {
        let n = v.len()
        var i = 0
        var neg = false
        if n > 0 && v.byte(0) == 45 {
            neg = true
            i = 1
        }
        if i == n { return .None }
        let lo = -9223372036854775807 - 1
        var x = 0
        while i < n {
            let d = v.byte(i) - 48
            if d < 0 || d > 9 { return .None }
            if x < (lo + d) / 10 { return .None }
            x = x * 10 - d
            i = i + 1
        }
        if neg { return .Some(x) }
        if x == lo { return .None }
        .Some(-x)
    }
}

fn view_space(c: I64) -> Bool { c == 32 || c == 9 || c == 10 || c == 13 }
