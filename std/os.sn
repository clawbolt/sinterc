// std.os：环境变量、目录、子进程。都是内建的 os_… 函数，这里给它们短的名字。
// 出错时 Err 里是“路径：系统的说明”。

// 环境变量；没有时 .None。
pub fn env(name: Str) -> Option<Str> { os_env(name) }

// 目录里的名字（不含 . 和 ..），按字节从小到大排好。
pub fn list_dir(path: Str) -> Result<Vec<Str>, Str> { os_list_dir(path) }

pub fn exists(path: Str) -> Bool { os_exists(path) }

pub fn is_dir(path: Str) -> Bool { os_is_dir(path) }

// 建一个目录（上一级要已经存在）。
pub fn make_dir(path: Str) -> Result<(), Str> { os_make_dir(path) }

// 删一个文件或空目录。
pub fn remove(path: Str) -> Result<(), Str> { os_remove(path) }

// 启动程序 prog（在 PATH 里找），参数原样传过去（不经过 shell），等它结束，返回退出码。
// 子进程和这个程序共用标准输入输出；被信号结束时退出码是 128 + 信号。
pub fn run(prog: Str, args: Vec<Str>) -> Result<I64, Str> { os_run(prog, args) }

// 和 run 一样，另外收集子进程的标准输出；退出码不是 0 时是 Err。
pub fn output(prog: Str, args: Vec<Str>) -> Result<Str, Str> { os_output(prog, args) }

// 立刻结束程序，退出码是 code（只取低 8 位）。和 panic 一样不析构任何值。
pub fn exit(code: I64) { os_exit(code) }
