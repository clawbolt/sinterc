// std.view：字符串切片 &str in a（C61）的常用函数。切片不拥有内存，这里的函数都不分配新的字符串，
// 结果是同一块缓冲区里的切片（Lean M27 的一：子切片仍在缓冲区里）。缓冲区用 text(a, s) 放进区域 a。
//
//     arena |a| {
//         let line = text(a, "x, 42 ,y")
//         let parts = view.split(line, ",")
//         print(view.trim(parts[1]).to_str())   // 42
//     }

// 按 sep 切开（sep 不能为空）：n 个 sep 得到 n + 1 段，段可以是空的
pub fn split(v: &str in r, sep: Str) -> Vec<&str in r> {
    if str_len(sep) == 0 { panic("split 的分隔符不能为空") }
    var out: Vec<&str in r> = vec_new()
    var start = 0
    var i = v.find(sep, 0)
    while i >= 0 {
        out.push(v.sub(start, i))
        start = i + str_len(sep)
        i = v.find(sep, start)
    }
    out.push(v.sub(start, v.len()))
    out
}

// 按行切开：去掉行尾的 \n 和 \r\n；最后一行后面有没有换行都一样，空的切片没有行
pub fn lines(v: &str in r) -> Vec<&str in r> {
    var out: Vec<&str in r> = vec_new()
    let n = v.len()
    var start = 0
    while start < n {
        var e = v.find("\n", start)
        if e < 0 { e = n }
        var stop = e
        if stop > start && v.byte(stop - 1) == 13 { stop = stop - 1 }
        out.push(v.sub(start, stop))
        start = e + 1
    }
    out
}

fn is_space(c: I64) -> Bool { c == 32 || c == 9 || c == 10 || c == 13 }

// 不收集成 Vec 的逐行访问：从 pos 开始的这一行在哪里结束（\n 的位置，没有时是 len）。
//     var pos = 0
//     while pos < data.len() {
//         let e = view.line_end(data, pos)
//         let line = view.trim_cr(data.sub(pos, e))
//         …
//         pos = e + 1
//     }
pub fn line_end(v: &str in r, pos: I64) -> I64 {
    let e = v.find("\n", pos)
    if e < 0 { v.len() } else { e }
}

// 去掉行尾的一个 \r（\r\n 换行的文件）
pub fn trim_cr(v: &str in r) -> &str in r {
    let n = v.len()
    if n > 0 && v.byte(n - 1) == 13 { v.sub(0, n - 1) } else { v }
}

// 按 sep 切开后的第 i 段（从 0 开始，sep 不能为空），没有这么多段时是 .None；和 split(v, sep)[i] 相同，但不建 Vec
pub fn field(v: &str in r, sep: Str, i: I64) -> Option<&str in r> {
    if str_len(sep) == 0 { panic("split 的分隔符不能为空") }
    if i < 0 { return .None }
    var start = 0
    var k = 0
    while k < i {
        let j = v.find(sep, start)
        if j < 0 { return .None }
        start = j + str_len(sep)
        k = k + 1
    }
    let e = v.find(sep, start)
    if e < 0 { .Some(v.sub(start, v.len())) } else { .Some(v.sub(start, e)) }
}

// 逐块读标准输入（C63，Lean M28）：峰值内存只和块大小、最长的一行有关，和输入大小无关。
// 上一块最后一个换行之后不完整的部分（carry）留在 LineReader 里，接在下一块前面；不管输入怎么分块，
// 逐块得到的行和整个读进来再 lines 的行相同（M28 的 stream_eq）。每块放在自己的区域里，处理完就释放：
//
//     var r = view.line_reader()
//     var going = true
//     while going {
//         arena |b| {
//             match view.next_block(r, b, 65536) {
//                 .Some(block) => { for line in view.lines(block) { … } },
//                 .None => { going = false }
//             }
//         }
//     }
pub struct LineReader { carry: Str, done: Bool }

pub fn line_reader() -> LineReader { LineReader { carry: "", done: false } }

// 下一段完整的行（以换行结束；输入最后没有换行时，最后一段是剩下的部分），放在区域 a 里；读完时是 .None。
// 每次最多读 n 个字节；一块里没有换行时接着读，直到碰到换行或者读完
pub fn next_block(inout r: LineReader, a: Arena, n: I64) -> Option<&str in a> {
    while !r.done {
        let c = read_chunk(a, n)
        if c.len() == 0 {
            r.done = true
            if r.carry.len() > 0 {
                let rest = r.carry.clone()
                r.carry = ""
                return .Some(text(a, rest))
            }
            return .None
        }
        var i = c.len() - 1
        while i >= 0 && c.byte(i) != 10 { i = i - 1 }
        if i < 0 {
            r.carry.push(c.to_str())
        } else {
            var s = r.carry.clone()
            s.push(c.sub(0, i + 1).to_str())
            r.carry = c.sub(i + 1, c.len()).to_str()
            return .Some(text(a, s))
        }
    }
    .None
}

// 去掉两头的空格、制表符和换行
pub fn trim(v: &str in r) -> &str in r {
    var a = 0
    var b = v.len()
    while a < b && is_space(v.byte(a)) { a = a + 1 }
    while b > a && is_space(v.byte(b - 1)) { b = b - 1 }
    v.sub(a, b)
}

pub fn starts_with(v: &str in r, p: Str) -> Bool {
    if str_len(p) > v.len() { return false }
    v.sub(0, str_len(p)).eq(p)
}

pub fn ends_with(v: &str in r, p: Str) -> Bool {
    let n = v.len()
    let m = str_len(p)
    if m > n { return false }
    v.sub(n - m, n).eq(p)
}

// 十进制整数（可以有一个负号）；格式不对或超出 I64 范围时是 .None，和 Str 的 to_i64 一样。
// 按负数累加，这样 I64 的最小值也能表示
pub fn to_i64(v: &str in r) -> Option<I64> {
    let n = v.len()
    var i = 0
    var neg = false
    if n > 0 && v.byte(0) == 45 {
        neg = true
        i = 1
    }
    if i == n { return .None }
    let min = -9223372036854775807 - 1
    var x = 0
    while i < n {
        let d = v.byte(i) - 48
        if d < 0 || d > 9 { return .None }
        if x < (min + d) / 10 { return .None }
        x = x * 10 - d
        i = i + 1
    }
    if neg { return .Some(x) }
    if x == min { return .None }
    .Some(-x)
}
