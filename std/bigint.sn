// std.bigint：任意大小的整数（Lean `Library.BigInt`）。一个数是符号加上从低位到高位的各位，每一位 0 ≤ d < 10^9。
// 各位的加、减、乘、比较、除以小数和 `Library.BigInt` 的 addL、subL、mul1 / mulL、cmpL、divS 一一对应，结果都经过 make
// （`Library.BigInt` 的 norm：去掉高位的 0，值是 0 时符号取正），所以每个数只有一种写法。
// 一位乘一位再加进位不超过 10^18，I64 不会溢出；除以小数时余数乘 10^9 再加一位也不超过 10^18。
// 实现了 math.Eq 和 math.Ord，可以用 eq、cmp，也可以用 vec.sort 排序。转成字符串用 bigint.to_str(x)。

use std.math

pub struct BigInt { neg: Bool, mag: Vec<I64> }

fn base() -> I64 { 1000000000 }

// 第 i 位；超出长度的位是 0
fn digit(v: Vec<I64>, i: I64) -> I64 { if i < v.len() { v[i] } else { 0 } }

fn copy(v: Vec<I64>) -> Vec<I64> {
    var r: Vec<I64> = vec_new()
    for x in v { r.push(x) }
    r
}

// `Library.BigInt` 的 trim：去掉高位的 0
fn trim(inout v: Vec<I64>) {
    while v.len() > 0 {
        if v[v.len() - 1] != 0 { break }
        let old = v.pop()
    }
}

// `Library.BigInt` 的 norm：去掉高位的 0，值是 0 时符号取正
fn make(minus: Bool, sink mag: Vec<I64>) -> BigInt {
    trim(mag)
    let n = minus && mag.len() > 0
    BigInt { neg: n, mag: mag }
}

// `Library.BigInt` 的 addL：逐位相加带进位
fn add_mag(a: Vec<I64>, b: Vec<I64>) -> Vec<I64> {
    var r: Vec<I64> = vec_new()
    var c = 0
    for i in 0..math.max(a.len(), b.len()) {
        let x = digit(a, i) + digit(b, i) + c
        r.push(x % base())
        c = x / base()
    }
    if c != 0 { r.push(c) }
    r
}

// `Library.BigInt` 的 subL：逐位相减带借位，要求 a 不小于 b
fn sub_mag(a: Vec<I64>, b: Vec<I64>) -> Vec<I64> {
    var r: Vec<I64> = vec_new()
    var br = 0
    for i in 0..a.len() {
        var x = a[i] - digit(b, i) - br
        if x < 0 {
            x = x + base()
            br = 1
        } else {
            br = 0
        }
        r.push(x)
    }
    r
}

// `Library.BigInt` 的 mul1：乘一位
fn mul1(a: Vec<I64>, d: I64) -> Vec<I64> {
    var r: Vec<I64> = vec_new()
    var c = 0
    for x in a {
        let y = x * d + c
        r.push(y % base())
        c = y / base()
    }
    if c != 0 { r.push(c) }
    r
}

// `Library.BigInt` 的 mulL：从 b 的最高位开始，acc = mul1(a, b[j]) + acc 左移一位
fn mul_mag(a: Vec<I64>, b: Vec<I64>) -> Vec<I64> {
    var acc: Vec<I64> = vec_new()
    var j = b.len() - 1
    while j >= 0 {
        var s: Vec<I64> = vec_new()
        s.push(0)
        for x in acc { s.push(x) }
        acc = add_mag(mul1(a, b[j]), s)
        j = j - 1
    }
    acc
}

// `Library.BigInt` 的 cmpL：从高位往低位找第一个不同的位
fn cmp_mag(a: Vec<I64>, b: Vec<I64>) -> I64 {
    var i = math.max(a.len(), b.len()) - 1
    while i >= 0 {
        let x = digit(a, i)
        let y = digit(b, i)
        if x < y { return -1 }
        if x > y { return 1 }
        i = i - 1
    }
    0
}

pub fn zero() -> BigInt { BigInt { neg: false, mag: vec_new() } }

// 负数逐位取 -(y % 10^9)，不先取绝对值，所以 I64 最小的数也不会溢出
pub fn from_i64(x: I64) -> BigInt {
    var m: Vec<I64> = vec_new()
    var y = x
    while y != 0 {
        let d = y % base()
        if d < 0 { m.push(-d) } else { m.push(d) }
        y = y / base()
    }
    make(x < 0, m)
}

pub fn clone(a: BigInt) -> BigInt { BigInt { neg: a.neg, mag: copy(a.mag) } }

pub fn is_zero(a: BigInt) -> Bool { a.mag.len() == 0 }

// -1、0、1
pub fn sign(a: BigInt) -> I64 { if a.mag.len() == 0 { 0 } else if a.neg { -1 } else { 1 } }

pub fn neg(a: BigInt) -> BigInt { make(!a.neg, copy(a.mag)) }

pub fn abs(a: BigInt) -> BigInt { make(false, copy(a.mag)) }

// `Library.BigInt` 的 addZ：同号时各位相加；异号时大的减小的，符号取大的那个的
pub fn add(a: BigInt, b: BigInt) -> BigInt {
    if a.neg == b.neg {
        make(a.neg, add_mag(a.mag, b.mag))
    } else if cmp_mag(a.mag, b.mag) == -1 {
        make(b.neg, sub_mag(b.mag, a.mag))
    } else {
        make(a.neg, sub_mag(a.mag, b.mag))
    }
}

// `Library.BigInt` 的 subZ：a + (-b)
pub fn sub(a: BigInt, b: BigInt) -> BigInt {
    let nb = neg(b)
    add(a, nb)
}

// `Library.BigInt` 的 mulZ
pub fn mul(a: BigInt, b: BigInt) -> BigInt { make(a.neg != b.neg, mul_mag(a.mag, b.mag)) }

pub fn pow(a: BigInt, e: I64) -> BigInt {
    if e < 0 { panic("bigint.pow 的指数不能是负数") }
    var r = from_i64(1)
    var b = clone(a)
    var k = e
    while k > 0 {
        if k % 2 == 1 { r = mul(r, b) }
        k = k / 2
        if k > 0 { b = mul(b, b) }
    }
    r
}

// `Library.BigInt` 的 divS：从高位往低位除以 d（1 ≤ d ≤ 10^9）。和 I64 的 / % 一样，商向零取整，余数的符号和 a 相同。
pub fn divmod_small(a: BigInt, d: I64) -> (BigInt, I64) {
    if d < 1 || d > base() { panic("bigint.divmod_small 的除数要在 1 到 1000000000 之间") }
    let n = a.mag.len()
    var q: Vec<I64> = vec_new()
    for i in 0..n { q.push(0) }
    var r = 0
    var i = n - 1
    while i >= 0 {
        let cur = r * base() + a.mag[i]
        q[i] = cur / d
        r = cur % d
        i = i - 1
    }
    let rr = if a.neg { -r } else { r }
    (make(a.neg, q), rr)
}

// 十进制：最高位直接写，其余每一位补足 9 个数字
pub fn to_str(a: BigInt) -> Str {
    let n = a.mag.len()
    if n == 0 { return "0" }
    var s = ""
    if a.neg { s.push("-") }
    s.push(str_from_i64(a.mag[n - 1]))
    var i = n - 2
    while i >= 0 {
        let d = str_from_i64(a.mag[i])
        var k = d.len()
        while k < 9 {
            s.push("0")
            k = k + 1
        }
        s.push(d)
        i = i - 1
    }
    s
}

// 十进制，可以有一个正负号（45 是 '-'，43 是 '+'），后面至少一个数字；格式不对时 .None。
// 从末尾起每 9 个数字是一位。
pub fn parse(s: Str) -> Option<BigInt> {
    let n = s.len()
    var start = 0
    var minus = false
    if n > 0 && (s.byte(0) == 45 || s.byte(0) == 43) {
        minus = s.byte(0) == 45
        start = 1
    }
    if start == n { return .None }
    for i in start..n {
        let c = s.byte(i)
        if c < 48 || c > 57 { return .None }
    }
    var m: Vec<I64> = vec_new()
    var j = n
    while j > start {
        let k = math.max(start, j - 9)
        match s.slice(k, j).to_i64() {
            .Some(d) => m.push(d),
            .None => ()
        }
        j = k
    }
    .Some(make(minus, m))
}

// 0 只有一种写法，所以相等就是符号和各位都相同
impl math.Eq for BigInt {
    fn eq(a: BigInt, b: BigInt) -> Bool { a.neg == b.neg && cmp_mag(a.mag, b.mag) == 0 }
}

// 先比符号；同号时比各位，负数时反过来
impl math.Ord for BigInt {
    fn cmp(a: BigInt, b: BigInt) -> I64 {
        if a.neg != b.neg {
            if a.neg { -1 } else { 1 }
        } else if a.neg {
            cmp_mag(b.mag, a.mag)
        } else {
            cmp_mag(a.mag, b.mag)
        }
    }
}
