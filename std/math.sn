// std.math：整数和 F64 的常用函数。比较用的 Eq、Ord 在预导入的核心部分。

pub fn min(a: I64, b: I64) -> I64 { if a < b { a } else { b } }

pub fn max(a: I64, b: I64) -> I64 { if a > b { a } else { b } }

// 最小的 I64 没有相反数，abs 会因为溢出而 panic。
pub fn abs(n: I64) -> I64 { if n < 0 { -n } else { n } }

pub fn sign(n: I64) -> I64 { if n < 0 { -1 } else if n > 0 { 1 } else { 0 } }

// 把 x 限制在 [lo, hi] 里（要求 lo <= hi）。
pub fn clamp(x: I64, lo: I64, hi: I64) -> I64 { max(lo, min(x, hi)) }

// b 的 e 次方（e < 0 时是 1）；溢出时 panic。
pub fn pow(b: I64, e: I64) -> I64 {
    var r = 1
    var i = 0
    while i < e {
        r = r * b
        i = i + 1
    }
    r
}

// 两个值里较小的（相等时取第一个），另一个被析构。
pub fn min_of<T: Ord>(sink a: T, sink b: T) -> T {
    if a.cmp(b).is_le() { a } else { b }
}

pub fn max_of<T: Ord>(sink a: T, sink b: T) -> T {
    if a.cmp(b).is_ge() { a } else { b }
}

// F64。按 IEEE 754：溢出得到 inf，0.0 / 0.0 得到 NaN；NaN 和任何数比较（包括自己）都不相等。
pub fn sqrt(x: F64) -> F64 { f64_sqrt(x) }

pub fn floor(x: F64) -> F64 { f64_floor(x) }

pub fn ceil(x: F64) -> F64 { f64_ceil(x) }

// 四舍五入，正好在中间时远离 0（2.5 是 3.0，-2.5 是 -3.0）。
pub fn round(x: F64) -> F64 { f64_round(x) }

pub fn fabs(x: F64) -> F64 { if x < 0.0 { -x } else { x } }

pub fn fmin(a: F64, b: F64) -> F64 { if a < b { a } else { b } }

pub fn fmax(a: F64, b: F64) -> F64 { if a > b { a } else { b } }

pub fn is_nan(x: F64) -> Bool { f64_is_nan(x) }

pub fn pi() -> F64 { 3.141592653589793 }

// b 的 e 次方（e 是整数，可以是负数）。
pub fn powi(b: F64, e: I64) -> F64 {
    var r = 1.0
    var i = 0
    let n = if e < 0 { -e } else { e }
    while i < n {
        r = r * b
        i = i + 1
    }
    if e < 0 { 1.0 / r } else { r }
}

// 最大公约数：总是非负，gcd(0, 0) == 0。
pub fn gcd(a: I64, b: I64) -> I64 {
    var x = abs(a)
    var y = abs(b)
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    x
}

// 最小公倍数：总是非负，有一个是 0 时是 0。
pub fn lcm(a: I64, b: I64) -> I64 {
    if a == 0 || b == 0 { 0 } else { abs(a / gcd(a, b) * b) }
}
