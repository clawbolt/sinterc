// C35：用标准库的程序。标准库的函数（含泛型和 trait）一起导出，由 Lean 检查。

fn parse(s: Str) -> Result<I64, Str> {
    match s.parse_i64() {
        .Some(n) => Ok(n),
        .None => Err("不是整数：".concat(s))
    }
}

fn main() {
    println("{(2).pow(5).clamp(0, 20)}")
    println(min("pear", "fig"))
    println(parse("12").unwrap_or(0).to_str())
    var v: Vec<Str> = "x,y,z".split(",")
    v.reverse()
    println(v.join("-"))
    println(v.contains("y").to_str())
    println(v.index_of("z").unwrap_or(-1).to_str())
}
