// C35：用标准库的程序。标准库的函数（含泛型和 trait）一起导出，由 Lean 检查。
use std.math
use std.option
use std.result
use std.vec
use std.str

fn parse(s: Str) -> Result<I64, Str> {
    match str_to_i64(s) {
        .Some(n) => Ok(n),
        .None => Err(str_concat("不是整数：", s))
    }
}

fn main() {
    print_i64(math.clamp(math.pow(2, 5), 0, 20))
    print(math.min_of("pear", "fig"))
    print_i64(result.unwrap_or(parse("12"), 0))
    var v: Vec<Str> = str.split("x,y,z", ",")
    vec.reverse(v)
    print(str.join(v, "-"))
    print_bool(vec.contains(v, "y"))
    print_i64(option.unwrap_or(vec.index_of(v, "z"), -1))
}
