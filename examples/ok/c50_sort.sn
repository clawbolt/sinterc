use std.vec

struct Person { name: Str, age: I64 }

fn show(v: Vec<I64>) {
    var s = ""
    var first = true
    for x in v {
        if !first { s.push(" ") }
        s.push("{x}")
        first = false
    }
    print(s)
}

fn next(inout s: I64) -> I64 {
    s = (s * 1103515245 + 12345) % 2147483648
    s % 1000
}

fn insertion(inout v: Vec<I64>) {
    var i = 1
    while i < vec_len(v) {
        var j = i
        while j > 0 && vec_get(v, j - 1) > vec_get(v, j) {
            vec_swap(v, j - 1, j)
            j = j - 1
        }
        i = i + 1
    }
}

fn main() {
    var a: Vec<I64> = vec_new()
    a.push(5)
    a.push(3)
    a.push(8)
    a.push(1)
    a.push(9)
    a.push(2)
    a.push(7)
    a.push(2)
    vec.sort(a)
    show(a)
    vec.sort_by(a, |x, y| x > y)
    show(a)
    var e: Vec<I64> = vec_new()
    vec.sort(e)
    print_i64(vec_len(e))
    e.push(4)
    vec.sort(e)
    show(e)
    var w: Vec<Str> = vec_new()
    w.push("pear")
    w.push("apple")
    w.push("fig")
    w.push("banana")
    vec.sort(w)
    for s in w {
        print(s)
    }
    var ps: Vec<Person> = vec_new()
    ps.push(Person { name: "Ann", age: 30 })
    ps.push(Person { name: "Bo", age: 25 })
    ps.push(Person { name: "Cy", age: 35 })
    ps.push(Person { name: "Di", age: 28 })
    vec.sort_by(ps, |p, q| p.age < q.age)
    for p in ps {
        print("{p.name} {p.age}")
    }
    var f: Vec<F64> = vec_new()
    f.push(3.0)
    f.push(-1.5)
    f.push(2.25)
    f.push(0.0)
    vec.sort_by(f, |x, y| x < y)
    for x in f {
        print_f64(x)
    }
    // 和插入排序对照：2000 个伪随机数
    var seed = 42
    var b: Vec<I64> = vec_new()
    var c: Vec<I64> = vec_new()
    for i in 0..2000 {
        let x = next(seed)
        b.push(x)
        c.push(x)
    }
    vec.sort(b)
    insertion(c)
    var same = true
    for i in 0..2000 {
        if vec_get(b, i) != vec_get(c, i) { same = false }
    }
    print_bool(same)
}
