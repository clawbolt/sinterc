// C38：panic。走到 panic 的路径不析构、不要求消费线性值；导出时写成指向自己的空节点（Lean M19 的编码）。

use std.io

linear struct Tx { id: I64 }

fn close(sink t: Tx) { consume(t) }

fn main() {
    let t = Tx { id: 1 }
    let n = "5".parse_i64().unwrap()
    if n < 0 { panic("负数") }
    close(t)
    let s = io.read_line().expect("没有输入")
    println(s)
}
