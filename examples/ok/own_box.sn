struct Pair { a: Box<I64>, n: I64 }

fn take(sink b: Box<I64>) -> I64 {
    *b + 1
}

fn make(x: I64) -> Box<I64> {
    box(x * 10)
}

fn main() {
    let b = box(41)
    println("{take(b)}")
    var c = make(1)
    c = make(2)
    println("{*c}")
    var i = 0
    while i < 3 {
        let t = box(i)
        i = *t + 1
    }
    let p = Pair { a: box(7), n: 3 }
    println("{*p.a + p.n}")
    let d = box(5)
    if i > 100 { println("{take(d)}") }
    let e = box(6)
    if i < 100 { println("{take(e)}") }
    var m = box(1)
    println("{take(m)}")
    m = box(2)
    println("{*m}")
    println("{*make(4)}")
}
