use std.vec
use std.fs

fn show(v: Vec<I64>) {
    var s = ""
    var first = true
    for x in v {
        if !first { s.push(" ") }
        s.push("{x}")
        first = false
    }
    println(s)
}

fn main() {
    println("Hello, 世界!".to_upper())
    println("ABC def".to_lower())
    println("a-b-c".replace("-", " + "))
    println("aaa".replace("aa", "b"))
    for l in "one\ntwo\r\n\nthree\n".lines() {
        println("[{l}]")
    }
    show(vec.range(5))
    var d: Vec<I64> = vec_new()
    d.push(1)
    d.push(1)
    d.push(2)
    d.push(2)
    d.push(2)
    d.push(3)
    d.push(1)
    d.push(1)
    d.dedup()
    show(d)
    match d.min() {
        .Some(m) => println("最小 {m}"),
        .None => println("空")
    }
    var t = vec.range(10).map(|x| x * 3)
    match t.binary_search(9) {
        .Some(i) => println("9 在 {i}"),
        .None => println("没有 9")
    }
    match t.binary_search(10) {
        .Some(i) => println("10 在 {i}"),
        .None => println("没有 10")
    }
    var f: Vec<F64> = vec_new()
    f.push(0.5)
    f.push(1.25)
    f.push(2.0)
    println("{f.sum()}")
    println("{(12).gcd(-18)}")
    println("{(4).lcm(6)}")
    println("{(0).gcd(0)}")
    var ls: Vec<Str> = vec_new()
    ls.push("第一行")
    ls.push("second")
    match fs.write_lines("out.txt", ls) {
        Ok(_) => println("写好了"),
        Err(e) => println(e)
    }
    match fs.read_lines("out.txt") {
        Ok(v) => {
            println("{v.len()}")
            for l in v {
                println(l)
            }
        },
        Err(e) => println(e)
    }
}
