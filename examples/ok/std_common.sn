use std.str
use std.vec
use std.math
use std.io

fn show(v: Vec<I64>) {
    var s = ""
    var first = true
    for x in v {
        if !first { s.push(" ") }
        s.push("{x}")
        first = false
    }
    print(s)
}

fn main() {
    print(str.to_upper("Hello, 世界!"))
    print(str.to_lower("ABC def"))
    print(str.replace("a-b-c", "-", " + "))
    print(str.replace("aaa", "aa", "b"))
    for l in str.lines("one\ntwo\r\n\nthree\n") {
        print("[{l}]")
    }
    show(vec.range(5))
    var d: Vec<I64> = vec_new()
    d.push(1)
    d.push(1)
    d.push(2)
    d.push(2)
    d.push(2)
    d.push(3)
    d.push(1)
    d.push(1)
    vec.dedup(d)
    show(d)
    match vec.min(d) {
        .Some(m) => print("最小 {m}"),
        .None => print("空")
    }
    var t = vec.map(vec.range(10), |x| x * 3)
    match vec.binary_search(t, 9) {
        .Some(i) => print("9 在 {i}"),
        .None => print("没有 9")
    }
    match vec.binary_search(t, 10) {
        .Some(i) => print("10 在 {i}"),
        .None => print("没有 10")
    }
    var f: Vec<F64> = vec_new()
    f.push(0.5)
    f.push(1.25)
    f.push(2.0)
    print_f64(vec.sum_f64(f))
    print_i64(math.gcd(12, -18))
    print_i64(math.lcm(4, 6))
    print_i64(math.gcd(0, 0))
    var ls: Vec<Str> = vec_new()
    ls.push("第一行")
    ls.push("second")
    match io.write_lines("out.txt", ls) {
        Ok(_) => print("写好了"),
        Err(e) => print(e)
    }
    match io.read_lines("out.txt") {
        Ok(v) => {
            print_i64(vec_len(v))
            for l in v {
                print(l)
            }
        },
        Err(e) => print(e)
    }
}
