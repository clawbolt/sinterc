// C59：可以存起来的闭包 Fn(T) -> U（Lean M26）：返回、存进 Vec 和结构体、计数器、按值拿进来的 Str、组合。

struct Button { label: Str, on_click: Fn(I64) -> I64 }

fn adder(k: I64) -> Fn(I64) -> I64 {
    |x| x + k
}

fn counter() -> Fn() -> I64 {
    var n = 0
    || {
        n = n + 1
        n
    }
}

fn compose(sink f: Fn(I64) -> I64, sink g: Fn(I64) -> I64) -> Fn(I64) -> I64 {
    |x| g(f(x))
}

fn main() {
    var c = counter()
    println("{c()}")
    println("{c()}")
    var fs: Vec<Fn(I64) -> I64> = Vec.new()
    fs.push(adder(1))
    fs.push(compose(adder(2), adder(3)))
    for i in 0..fs.len() {
        println("{fs[i].call(10)}")
    }
    let name = "ann"
    var greet: Fn() -> () = || println(name)
    greet()
    var b = Button { label: "ok", on_click: |n| n * 2 }
    println("{b.on_click.call(21)}")
    var v: Vec<I64> = Vec.new()
    v.push(1)
    var add = adder(5)
    let w = v.map(add)
    println("{w[0]}")
}
