use std.math

fn area(r: F64) -> F64 {
    math.pi() * r * r
}

fn mean(v: Vec<F64>) -> F64 {
    var s = 0.0
    for x in v {
        s = s + x
    }
    s / v.len().to_f64()
}

fn main() {
    println("{0.1 + 0.2}")
    println("{2.0}")
    println("{1.5e3}")
    println("{-0.25}")
    println("{area(2.0)}")
    var v: Vec<F64> = Vec.new()
    v.push(1.0)
    v.push(2.5)
    v.push(4.0)
    println("{mean(v)}")
    println("{(2.0).sqrt()}")
    println("{(3.99).to_i64()}")
    println("{(-3.99).to_i64()}")
    println("{(2.5).round()}")
    println("{(-1.5).floor()}")
    println("{(2.0).powi(-3)}")
    println("{0.1 + 0.2 == 0.3}")
    println("{1.0 < 2.0}")
    println("x = ".concat((1.0 / 3.0).to_str()))
    match "2.75".parse_f64() {
        .Some(x) => println("{x * 2.0}"),
        .None => println("不是数")
    }
    match "abc".parse_f64() {
        .Some(x) => println("{x}"),
        .None => println("不是数")
    }
    // t.0.1 仍然是取嵌套元组的元素，不是浮点数 0.1
    let t = ((1, 2), 3)
    println("{t.0.1}")
    let z = 0.0
    println("{(z / z).is_nan()}")
    println("{1.0 / z}")
    println("{1e20}")
}
