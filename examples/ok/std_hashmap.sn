use std.hashmap
use std.map

fn next(inout s: I64) -> I64 {
    s = (s * 1103515245 + 12345) % 2147483648
    s / 65536
}

fn main() {
    var ages: hashmap.HashMap<Str, I64> = hashmap.HashMap.new()
    ages.insert("Ann", 30)
    ages.insert("Bo", 25)
    ages.insert("Cy", 35)
    match ages.insert("Bo", 26) {
        .Some(old) => println("Bo 原来 {old}"),
        .None => println("新键")
    }
    println("{ages.len()}")
    match ages.get("Bo") {
        .Some(a) => println("Bo 明年 {*a + 1}"),
        .None => println("没有 Bo")
    }
    println(ages.contains("Di").to_str())
    match ages.remove("Ann") {
        .Some(a) => println("删掉 Ann {a}"),
        .None => println("没有 Ann")
    }
    println(ages.contains("Ann").to_str())
    // 按 keys 的顺序：删掉 Ann 时最后一个（Cy）换到了它的位置
    ages.for_each(|k, v| println("{k}: {v}"))
    // 和 std.map 对照：3000 次随机的插入、删除、查找，键在 0..500 里
    var h: hashmap.HashMap<I64, I64> = hashmap.HashMap.new()
    var m: map.Map<I64, I64> = map.Map.new()
    var seed = 7
    var bad = 0
    for i in 0..3000 {
        let k = next(seed) % 500
        let op = next(seed) % 3
        if op == 0 {
            let a = h.insert(k, i)
            let b = m.insert(k, i)
            if a.is_some() != b.is_some() { bad = bad + 1 }
        } else if op == 1 {
            let a = h.remove(k)
            let b = m.remove(k)
            if a.is_some() != b.is_some() { bad = bad + 1 }
        } else {
            if h.contains(k) != m.contains(k) { bad = bad + 1 }
        }
        if h.len() != m.len() { bad = bad + 1 }
    }
    for k in 0..500 {
        if h.contains(k) != m.contains(k) { bad = bad + 1 }
    }
    println("不一致 {bad} 次，最后 {h.len()} 个键")
    var big: hashmap.HashMap<I64, I64> = hashmap.HashMap.new()
    for i in 0..10000 {
        big.insert(i * 1024, i)
    }
    var sum = 0
    for i in 0..10000 {
        match big.get(i * 1024) {
            .Some(v) => { sum = sum + *v },
            .None => {}
        }
    }
    println("{sum}")
}
