fn divmod(a: I64, b: I64) -> (I64, I64) {
    (a / b, a % b)
}

fn swap<A, B>(sink p: (A, B)) -> (B, A) {
    let (a, b) = p
    (b, a)
}

fn main() {
    let p = (1, true)
    print_i64(p.0)
    print_bool(p.1)
    let (q, r) = divmod(17, 5)
    print_i64(q * 10 + r)
    // 元素都可以复制时，元组也可以复制
    let a = (3, 4)
    let b = a
    print_i64(a.0 + b.1)
    var v = ((1, 2), 3)
    v.0.1 = 20
    v.1 = 30
    print_i64(v.0.0 + v.0.1 + v.1)
    let s = swap(("左", 5))
    print_i64(s.0)
    print(s.1)
    var names: Vec<(Str, I64)> = vec_new()
    names.push(("ann", 31))
    names.push(("bob", 27))
    for x in names {
        print(str_concat(x.0, str_from_i64(x.1)))
    }
    let (n, age) = swap((40, "cy"))
    print(n)
    print_i64(age)
}
