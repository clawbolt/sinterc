// C37：() 作类型实参。泛型函数、Option<()>、Vec<()> 的实例连同 () 类型的变量、载荷一起导出给 Lean。

fn id<T>(sink x: T) -> T { x }

fn check(n: I64) -> Result<(), Str> {
    if n < 0 { return Err("负数") }
    Ok(())
}

fn main() {
    println("{check(1).is_ok()}")
    let u: () = id(())
    var v: Vec<()> = vec_new()
    v.push(u)
    match v.pop() {
        .Some(x) => println("有"),
        .None => println("空")
    }
    match check(-1) {
        Ok(z) => println("成功"),
        Err(e) => println(e)
    }
}
