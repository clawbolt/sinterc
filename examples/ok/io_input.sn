// C32：读入的每一行是新的 Str；match 移出载荷，break 之前析构循环里的值。
use std.io

fn main() {
    var lines: Vec<Str> = Vec.new()
    while true {
        match io.read_line() {
            .Some(l) => {
                if l.len() == 0 { break }
                lines.push(l.slice(0, l.len()))
            },
            .None => { break }
        }
    }
    for l in lines {
        match l.parse_i64() {
            .Some(n) => println("{n}"),
            .None => println(l)
        }
    }
}
