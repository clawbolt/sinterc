// C36：文件与参数。read_file、write_file 返回的 Result 按移动 match，Err 里的说明被析构；args() 的 Vec 逐个析构。
use std.fs
use std.env

fn copy_first(a: Vec<Str>) -> Result<(), Str> {
    if a.len() < 2 { return Err("用法：程序 源文件 目标文件") }
    let text = fs.read(a[0])?
    fs.write(a[1], text)?
    Ok(())
}

fn main() {
    let a = env.args()
    match copy_first(a) {
        Ok(_) => println("复制好了"),
        Err(e) => println(e)
    }
}
