// C61：字符串切片 &str in a。text(a, s) 把字符串放进区域 a，之后取子切片、按分隔符切开、按行切开都不分配。

struct Row<S> { name: S, qty: I64 }

// 返回的切片和参数在同一个区域里
fn first_field(line: &str in r) -> &str in r {
    let i = line.find(",", 0)
    if i < 0 { line } else { line.sub(0, i) }
}

fn parse(line: &str in r) -> Option<Row<&str in r>> {
    let parts = line.split(",")
    if parts.len() != 2 { return .None }
    match parts[1].trim().parse_i64() {
        .Some(q) => .Some(Row { name: parts[0].trim(), qty: q }),
        .None => .None
    }
}

fn main() {
    arena |a| {
        let data = text(a, "apple, 3\nbanana,12\r\n  cherry ,x\nplum,-7\n")
        let rows = data.lines()
        println("{rows.len()}")
        var total = 0
        for line in rows {
            match parse(line) {
                .Some(r) => {
                    r.name.print_str()
                    println(" {r.qty}")
                    total = total + r.qty
                },
                .None => println("跳过：{first_field(line)}")
            }
        }
        println("{total}")
        let w = data.sub(0, 5)
        println(w.to_str())
        println(w.eq("apple").to_str())
        println(data.starts_with("app").to_str())
        println(data.ends_with("-7\n").to_str())
        println("{data.byte(0)}")
        let empty = text(a, "").split(",")
        println("{empty.len()}")
        match text(a, "-9223372036854775808").parse_i64() {
            .Some(x) => println("{x}"),
            .None => println("None")
        }
        match text(a, "9223372036854775808").parse_i64() {
            .Some(x) => println("{x}"),
            .None => println("None")
        }
    }
}
