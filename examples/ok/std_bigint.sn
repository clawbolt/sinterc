// C54：std.bigint（Lean S10）。30 的阶乘、2 的 100 次方、第 100 个斐波那契数。

use std.bigint

fn fact(n: I64) -> bigint.BigInt {
    var r = bigint.from_i64(1)
    for i in 1..n + 1 {
        r = r.mul(bigint.from_i64(i))
    }
    r
}

fn main() {
    println(fact(30).to_str())
    println(bigint.from_i64(2).pow(100).to_str())
    var a = bigint.zero()
    var b = bigint.from_i64(1)
    for i in 0..100 {
        let c = a.add(b)
        a = b
        b = c
    }
    println(a.to_str())
    let (q, r) = a.divmod_small(1000)
    println("{q.to_str()} {r}")
}
