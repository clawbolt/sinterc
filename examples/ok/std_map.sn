use std.map

fn main() {
    var m: map.Map<I64, I64> = map.Map.new()
    for i in 0..1023 {
        let o = m.insert(i, i * i)
    }
    println("{m.len()}")
    println("{m.height()}")
    match m.get(64) {
        .Some(v) => println("{*v + 1}"),
        .None => println("没有")
    }
    println("{m.contains(1022)}")
    println("{m.contains(1023)}")
    match m.insert(5, 0) {
        .Some(x) => println("{x}"),
        .None => println("新键")
    }
    println("{m.len()}")
    var k = 0
    while k < 1023 {
        let o = m.remove(k)
        k = k + 2
    }
    match m.remove(0) {
        .Some(x) => println("{x}"),
        .None => println("已经删掉")
    }
    println("{m.len()}")
    println("{m.height() <= 10}")
    var ok = true
    var prev = -1
    var total = 0
    m.for_each(|key, v| {
        if key <= prev || key % 2 == 0 { ok = false }
        prev = key
        total = total + 1
    })
    println("{ok}")
    println("{total}")
    println("{m.contains(50)}")
    println("{m.contains(51)}")
}
