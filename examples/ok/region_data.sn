struct Pair<A, B> { a: A, b: B }

fn some<T>(sink x: T) -> Option<T> { .Some(x) }

fn get_or(o: Option<&I64 in x>, d: I64) -> I64 {
    match o {
        .Some(r) => *r,
        .None => d
    }
}

fn sum(p: Pair<&I64 in x, &I64 in y>) -> I64 { *p.a + *p.b }

fn main() {
    arena |a| {
        let r = alloc(a, 1)
        println("{get_or(some(r), 0)}")
        let n: Option<&I64 in a> = .None
        println("{get_or(n, -1)}")
        arena |b| {
            let s = alloc(b, 10)
            println(sum(Pair { a: r, b: s }).to_str())
            println("{get_or(some(s), 0)}")
        }
        var v: Vec<&I64 in a> = vec_new()
        v.push(r)
        v.push(alloc(a, 5))
        match v.pop() {
            .Some(t) => println("{*t}"),
            .None => println("{0}")
        }
        println("{v.len()}")
    }
}
