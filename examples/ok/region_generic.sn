fn id<T>(sink x: T) -> T { x }

fn pick<T>(c: Bool, sink x: T, sink y: T) -> T {
    if c { x } else { y }
}

fn sum(v: Vec<&I64 in a>) -> I64 {
    var s = 0
    var i = 0
    while i < v.len() {
        s = s + *vec_get(v, i)
        i = i + 1
    }
    s
}

fn main() {
    arena |a| {
        let r = alloc(a, 1)
        let r2 = id(r)
        println("{*r2}")
        arena |b| {
            let s = alloc(b, 10)
            println("{*pick(true, s, r)}")
            println("{*pick(false, s, r)}")
            println("{*id(s) + *id(r)}")
        }
        var v: Vec<&I64 in a> = vec_new()
        v.push(r)
        v.push(alloc(a, 2))
        v.push(id(alloc(a, 3)))
        println("{sum(v)}")
    }
}
