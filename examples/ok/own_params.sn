struct P { a: Box<I64>, n: I64 }

fn get(b: Box<I64>) -> I64 { *b }

fn inc(inout x: I64) { x = x + 1 }

fn reset(inout b: Box<I64>, sink v: I64) { b = box(v) }

fn sum(p: P, q: P) -> I64 { *p.a + *q.a }

fn main() {
    var b = box(1)
    println("{get(b)}")
    reset(b, 5)
    println("{*b}")
    var n = 10
    inc(n)
    println("{n}")
    let p = P { a: box(2), n: 3 }
    println("{sum(p, p)}")
    let a = p.a
    println("{*a + p.n}")
    var x = P { a: box(8), n: 0 }
    let pa = x.a
    println("{*pa}")
    x = P { a: box(9), n: 1 }
    println("{*x.a}")
    inc(x.n)
    println("{x.n}")
    println("{get(box(3))}")
}
