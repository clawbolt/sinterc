struct P { a: Box<I64>, b: Box<I64> }

fn take(sink b: Box<I64>) -> I64 { *b }

fn main() {
    var p = P { a: box(1), b: box(2) }
    let yes = true
    if yes {
        print_i64(take(p.a))
    }
    p.a = box(3)
    print_i64(*p.a + *p.b)
    var x = box(5)
    if yes {
        print_i64(take(x))
    }
    x = box(6)
    print_i64(*x)
}
