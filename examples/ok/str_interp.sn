struct Point { x: I64, y: I64 }

fn to_str(p: Point) -> Str {
    "({p.x}, {p.y})"
}

fn main() {
    let name = "世界"
    let n = 42
    print("你好，{name}！")
    print("n = {n}, n * 2 = {n * 2}")
    print("{1.5} {'中'} {n > 40} {true}")
    let p = Point { x: 3, y: -4 }
    print("p = {p}")
    print("{{原样}} {n}")
    print("嵌套：{"[{n}]"}")
    var s = "{n}"
    s.push("!")
    print(s)
    print(name)
    print("{str_len(name)} 字节")
    print(n.to_str())
}
