struct Point { x: I64, y: I64 }

fn to_str(p: Point) -> Str {
    "({p.x}, {p.y})"
}

fn main() {
    let name = "世界"
    let n = 42
    println("你好，{name}！")
    println("n = {n}, n * 2 = {n * 2}")
    println("{1.5} {'中'} {n > 40} {true}")
    let p = Point { x: 3, y: -4 }
    println("p = {p}")
    println("{{原样}} {n}")
    println("嵌套：{"[{n}]"}")
    var s = "{n}"
    s.push("!")
    println(s)
    println(name)
    println("{name.len()} 字节")
    println(n.to_str())
}
