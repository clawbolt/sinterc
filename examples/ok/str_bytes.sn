// C57：字节串 Bytes 和 UTF-8 的检查（Lean S11）。

fn checksum(b: Bytes) -> I64 {
    var s = 0
    for i in 0..b.len() { s = (s * 31 + b.get(i)) % 1000003 }
    s
}

fn lower(sink b: Bytes) -> Bytes {
    var r = b
    for i in 0..r.len() {
        let x = r.get(i)
        if x >= 65 && x <= 90 { r.set(i, x + 32) }
    }
    r
}

fn main() {
    let b = lower("Hello, 世界".to_bytes())
    println("{checksum(b)}")
    match b.decode() {
        .Some(s) => println(s),
        .None => println("?")
    }
}
