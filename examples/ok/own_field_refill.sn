struct P { a: Box<I64>, b: Box<I64> }

fn take(sink b: Box<I64>) -> I64 { *b }

fn main() {
    var p = P { a: box(1), b: box(2) }
    let yes = true
    if yes {
        println("{take(p.a)}")
    }
    p.a = box(3)
    println("{*p.a + *p.b}")
    var x = box(5)
    if yes {
        println("{take(x)}")
    }
    x = box(6)
    println("{*x}")
}
