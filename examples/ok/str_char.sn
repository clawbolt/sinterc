fn count_digits(s: Str) -> I64 {
    var n = 0
    for c in s.chars() {
        if c.is_digit() { n = n + 1 }
    }
    n
}

fn upper(s: Str) -> Str {
    var r = ""
    for c in s.chars() {
        r.push_char(c.to_upper())
    }
    r
}

fn reverse(s: Str) -> Str {
    let cs = s.chars()
    var r = ""
    var i = cs.len()
    while i > 0 {
        i = i - 1
        r.push_char(cs[i])
    }
    r
}

fn squares(n: I64) -> Vec<I64> {
    var v: Vec<I64> = vec_new()
    for i in 0..n {
        v.push(i * i)
    }
    v
}

fn main() {
    let s = "héllo, 世界 😀"
    println("{s.len()}")
    println("{s.char_count()}")
    for c in "a中😀".chars() {
        println("{c.code()}")
    }
    println("{'中'}")
    println(upper("abc-xyz 中文"))
    println(reverse("你好，abc"))
    println(count_digits("a1b22c333").to_str())
    println("{'a' < 'b'}")
    println("{'中' == '中'}")
    println("{'\t'.code()}")
    println("{'Q'.to_lower()}")
    match (65).to_char() {
        .Some(c) => println("{c}"),
        .None => println("不是字符")
    }
    match (55296).to_char() {
        .Some(c) => println("{c}"),
        .None => println("不是字符")
    }
    match '7'.to_digit() {
        .Some(d) => println("{d}"),
        .None => println("不是数字")
    }
    var t = '😀'.to_str()
    t.push_char('!')
    println(t)
    for x in squares(4) {
        println("{x}")
    }
}
