// C58：std.os——环境变量、目录、子进程。

use std.fs
use std.env
use std.process

fn count_files(dir: Str) -> I64 {
    match fs.list_dir(dir) {
        Ok(ns) => ns.len(),
        Err(e) => 0
    }
}

fn main() {
    let home = match env.get("HOME") {
        .Some(h) => h,
        .None => "."
    }
    println("{count_files(home)}")
    var args: Vec<Str> = Vec.new()
    args.push("hi")
    match process.run("echo", args) {
        Ok(c) => if c != 0 { env.exit(c) },
        Err(e) => println(e)
    }
}
