// HTTP 服务器的示例，用 std.http：每个连接交给 scope 里的一个任务（Lean `Concurrency.Scope`），连接上可以连续发多个请求。
//   sinterc run examples/tour/http_server.sn serve 8080        然后 curl http://127.0.0.1:8080/hello/世界
//   sinterc run examples/tour/http_server.sn selftest          服务端和客户端在同一个程序里各跑几个请求
use std.net
use std.http { Handler }
use std.env

// 处理器：所有连接的任务只读共享它
struct App { title: Str, greeting: Str }

impl Handler for App {
    fn handle(a: App, req: http.Request) -> http.Response {
        if req.method.eq("POST") && req.path.eq("/echo") {
            return http.Response.text(200, "收到 {req.body.len()} 个字节：{req.text()}\n")
        }
        if !req.method.eq("GET") && !req.method.eq("HEAD") { return http.Response.text(405, "不支持 {req.method}\n") }
        if req.path.eq("/") { return http.Response.text(200, "{a.title}\n") }
        match http.route(req.path, "/hello/:name") {
            .Some(ps) => {
                let greeting = req.query_param("greeting").unwrap_or(a.greeting.to_str())
                http.Response.text(200, "{greeting}，{ps[0]}\n")
            },
            .None => http.Response.text(404, "没有 {req.path}\n")
        }
    }
}

fn new_app() -> App { App { title: "Sinter 的 HTTP 示例", greeting: "你好" } }

fn summary(target: Str, r: Result<http.Response, Str>) -> Str {
    match r {
        Ok(resp) => "{resp.status} {resp.header("Content-Type").unwrap_or("-")} | {resp.text_body().trim()}",
        Err(e) => "{target}：{e}"
    }
}

// 客户端依次发请求；服务端接受同样多的连接后结束
fn selftest(l: net.TcpListener) {
    let base = "http://127.0.0.1:{l.port()}"
    var paths: Vec<Str> = Vec.new()
    paths.push("/")
    paths.push("/hello/世界")
    paths.push("/hello/%E4%B8%96%e7%95%8c?greeting=hi")
    paths.push("/missing")
    let n = paths.len() + 1
    let app = new_app()
    scope |s| {
        s.spawn(|| http.serve(l, n, app))
        for p in paths {
            let target = "{base}{p}"
            println(summary(target, http.get(target)))
        }
        let target = "{base}/echo"
        println(summary(target, http.post(target, "text/plain", "你好".to_bytes())))
    }
}

fn main() {
    let args = env.args()
    let test = args.len() >= 1 && args[0].eq("selftest")
    if !test && args.len() < 2 {
        eprintln("用法：http_server serve 端口 | http_server selftest")
        return
    }
    let port: Option<I64> = if test { .Some(0) } else { args[1].parse_i64() }
    match port {
        .Some(p) => {
            // linear 值（这里是 TcpListener）不能用 unwrap 取出，写成 match
            match net.listen("127.0.0.1", p) {
                Ok(l) => {
                    if test {
                        selftest(l)
                    } else {
                        println("在 http://127.0.0.1:{l.port()}/ 上监听")
                        http.serve(l, -1, new_app())
                    }
                    l.close()
                },
                Err(e) => eprintln(e)
            }
        },
        .None => eprintln("端口要是整数：{args[1]}")
    }
}
