// 词频统计：读文件（或标准输入），按词计数，按次数从多到少打印前 5 个。
// 用到 std.io、std.str、std.hashmap、std.vec 的 sort_by、闭包、元组和字符串插值。
// 运行：sinterc run words.sn 文件      或者      echo "a b a" | sinterc run words.sn

use std.io
use std.fs
use std.hashmap
use std.env

fn words_of(line: Str) -> Vec<Str> {
    var out: Vec<Str> = Vec.new()
    var w = ""
    for c in line.chars() {
        if c.is_alnum() || c.code() > 127 {
            w.push_char(c.to_lower())
        } else if w.len() > 0 {
            out.push(w)
            w = ""
        }
    }
    if w.len() > 0 { out.push(w) }
    out
}

fn main() {
    let a = env.args()
    var lines: Vec<Str> = Vec.new()
    if a.len() > 0 {
        match fs.read_lines(a[0]) {
            Ok(ls) => { lines = ls },
            Err(e) => panic(e)
        }
    } else {
        lines = io.input_lines()
    }
    var counts: hashmap.HashMap<Str, I64> = hashmap.HashMap.new()
    var total = 0
    for line in lines {
        for w in words_of(line) {
            total = total + 1
            let n = match counts.get(w) {
                .Some(c) => *c,
                _ => 0
            }
            // for 按借用给出 w，插入要拿走所有权，所以复制一份
            counts.insert(w.clone(), n + 1)
        }
    }
    var pairs: Vec<(Str, I64)> = Vec.new()
    counts.for_each(|k, v| pairs.push((k.clone(), v)))
    // 次数多的在前；次数相同按词的字典序
    pairs.sort_by(|p, q| p.1 > q.1 || (p.1 == q.1 && (p.0).cmp(q.0).is_lt()))
    println("共 {total} 个词，{counts.len()} 个不同的词")
    var i = 0
    for p in pairs {
        if i < 5 { println("{p.0}: {p.1}") }
        i = i + 1
    }
}
