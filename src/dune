;  按阶段分目录（见 ARCHITECTURE.md 的“目录”）：base 位置和报错，syntax 词法、语法、格式化，resolve 模块解析，
;  ir 阶段之间交接的数据，types 类型检查，mir 降级和所有权检查，back 两个后端。
;  子目录里的模块和这里的一样直接按名字用（unqualified），生成的 stdlib_src、runtime_src 在这一层。
(include_subdirs unqualified)

(library
 (name sinter))

; 标准库的源码编进编译器
(rule
 (targets stdlib_src.ml)
 (deps
  (glob_files %{project_root}/std/*.sn)
  (glob_files %{project_root}/std/core/*.sn))
 (action
  (with-stdout-to
   stdlib_src.ml
   (run %{exe:../gen/embed.exe} %{deps}))))

; C 运行时原样编进编译器：runtime/sinter.h 放在生成的 C 文件开头，runtime/sinter_lib.h 放在类型定义之后
; （两个文件都是 runtime/dune 从几个分开的文件拼出来的）
(rule
 (targets runtime_src.ml)
 (deps
  (:prelude %{project_root}/runtime/sinter.h)
  (:library %{project_root}/runtime/sinter_lib.h))
 (action
  (with-stdout-to
   runtime_src.ml
   (progn
    (echo "(* 由 src/dune 从 runtime/*.h 生成，不要手工修改。 *)\nlet prelude = {sinter_c|")
    (cat %{prelude})
    (echo "|sinter_c}\n\nlet library = {sinter_c|")
    (cat %{library})
    (echo "|sinter_c}\n")))))
